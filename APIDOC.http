# ==== USER ====

# api for creating user
###
POST http://127.0.0.1:8000/fit/signup/
Content-Type: application/json

{
    "username":"react",
    "email":"react@gmail.com",
    "password":"password@123"
}

# list user
###
GET http://127.0.0.1:8000/fit/me/
Accept: application/json
Authorization: Basic react:password@123

# ==== MEAL RECORD SECTION ====

# api for list all user meal record
###
GET http://127.0.0.1:8000/fit/meal/
Accept: application/json
Authorization: Basic django:password@123

# api for create a meal record
###
POST http://127.0.0.1:8000/fit/meal/
Content-Type: application/json
Authorization: Basic django:password@123

{
    "title" : "dosa",

    "calorie" : "250",

    "meal_type" : "BREAKFAST",

    "serving_size" : "Large"
}

# api for detail user record
###
GET http://127.0.0.1:8000/fit/meal/2/
Accept: application/json
Authorization: Basic django:password@123

# api for updating record
###
PUT http://127.0.0.1:8000/fit/meal/2/
Content-Type: application/json
Authorization: Basic django:password@123

{
  "id": 2,
  "title": "idali",
  "calorie": 250,
  "meal_type": "BREAKFAST",
  "serving_size": "4 piece",
  "created_at": "2026-10-10T06:18:51.689765Z",
  "owner": 1
}

# api for delete record
###
DELETE http://127.0.0.1:8000/fit/meal/2/
Accept: application/json
Authorization: Basic django:password@123